/dev/block/mmcblk0p1    /boot       vfat    ro                              wait
/dev/block/mmcblk0p2    /system     ext4    ro,barrier=1                    wait
/dev/block/mmcblk0p3    /vendor     ext4    ro,barrier=1                    wait
/dev/block/mmcblk0p4    /data       ext4    noatime,nosuid,nodev,discard    wait,formattable
