# Second-stage fstab (processed by mount_all in init.rpi5.rc).
# /boot, /system, /vendor are mounted in first stage via DT overlay android-sdcard.
#<src>                <mnt_point>  <type>  <mnt_flags>              <fs_mgr_flags>
/dev/block/mmcblk0p4  /data        ext4    noatime,nosuid,nodev     wait,check,formattable
