# The Power HAL raises the cpufreq minimum during interaction and app launch.
on boot
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq

service vendor.power-rpi5 /vendor/bin/hw/android.hardware.power-service.rpi5
    class hal
    user system
    group system
