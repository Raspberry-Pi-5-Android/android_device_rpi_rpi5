# Board-specific init for Raspberry Pi 5
# First stage (DT overlay android-sdcard) mounts /system and /vendor.
# /data is mounted here in second stage.
on fs
    mount_all /vendor/etc/fstab.rpi5

# TEMPORARY (bring-up, SELinux permissive only).
# The kernel has no ashmem driver, and platform init.rc sets sys.use_memfd=false
# in post-fs-data. Re-enable libcutils' memfd backend in the same trigger
# (vendor actions run after platform ones), before zygote-start.
# use_memfd_prop is platform-restricted (neverallow for vendor_init):
# replace with a kernel ashmem driver before switching SELinux to enforcing.
on post-fs-data
    setprop sys.use_memfd true

# Kernel firmware search path. The Wi-Fi and Bluetooth firmware is installed in
# /vendor/firmware, which first stage has already mounted.
on early-init
    write /sys/module/firmware_class/parameters/path /vendor/firmware

# Wi-Fi and Bluetooth drivers for the CYW43455. brcmfmac needs its firmware
# vendor module (brcmfmac-wcc) registered before it probes the SDIO card, and
# Android disables kernel module autoloading, so the SDIO host of the Wi-Fi chip
# is unbound while the modules load and bound again afterwards. The host is
# named by its fixed DT address; 1000fff000.mmc is the SD card host.
on early-boot
    write /sys/bus/platform/drivers/sdhci-brcmstb/unbind 1001100000.mmc
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules brcmfmac-wcc.ko hci_uart.ko
    write /sys/bus/platform/drivers/sdhci-brcmstb/bind 1001100000.mmc

# wpa_supplicant keeps its configuration and control sockets here.
on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
