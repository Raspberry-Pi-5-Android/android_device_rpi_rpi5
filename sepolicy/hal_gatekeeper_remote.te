# Gatekeeper HAL from the com.android.hardware.gatekeeper.nonsecure APEX
# (AOSP nonsecure implementation). The "remote" type name is fixed by that
# APEX's file_contexts. It also serves ISharedSecret/gatekeeper for keystore2.
# Minimal definition for bring-up; refine before enforcing.
type hal_gatekeeper_remote, domain;
type hal_gatekeeper_remote_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_gatekeeper_remote)

hal_server_domain(hal_gatekeeper_remote, hal_gatekeeper)
